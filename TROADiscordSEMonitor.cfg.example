<?xml version="1.0" encoding="utf-8"?>
<BridgeConfig>
  <!-- Required Discord connection and routing -->
  <BotToken>PASTE_A_NEW_DISCORD_BOT_TOKEN_HERE</BotToken>
  <ChatChannelId>PASTE_MAIN_DISCORD_CHANNEL_ID_HERE</ChatChannelId>
  <!-- Discord-to-game chat styling. TextColor is a Space Engineers chat font name. -->
  <!-- HighlightColor accepts a name, #RRGGBB, #RRGGBBAA, or R,G,B. Invalid values fall back to teal. -->
  <DiscordGameTextColor>White</DiscordGameTextColor>
  <DiscordGameHighlightColor>#00B7C3</DiscordGameHighlightColor>
  <CommandChannelId>PASTE_PRIVATE_ADMIN_CHANNEL_ID_HERE</CommandChannelId>
  <ServerName>Space Engineers</ServerName>
  <!-- Player-facing system announcements default to Monitor+; customize if desired. -->
  <AdvertisementAuthor>Monitor+</AdvertisementAuthor>
  <!-- Suppresses duplicate automatic-save detections from one save cycle. -->
  <SaveNotificationCooldownSeconds>300</SaveNotificationCooldownSeconds>
  <StatusChannelId></StatusChannelId>
  <PlayerStatusChannelId></PlayerStatusChannelId>
  <AdminLogChannelId></AdminLogChannelId>
  <StatusDashboardChannelId></StatusDashboardChannelId>
  <GridComplianceLogChannelId></GridComplianceLogChannelId>
  <VotingCommandChannelId></VotingCommandChannelId>
  <HealthAlertChannelId></HealthAlertChannelId>

  <!-- Administrator access and approved remote Torch commands -->
  <AdminSteamIds>
    <string>PASTE_ADMIN_STEAM_ID_64_HERE</string>
  </AdminSteamIds>
  <DiscordSteamMappings>
    <string>PASTE_ADMIN_DISCORD_USER_ID:PASTE_ADMIN_STEAM_ID_64_HERE</string>
  </DiscordSteamMappings>
  <AdminDiscordUserIds>
    <string>PASTE_ADMIN_DISCORD_USER_ID_HERE</string>
  </AdminDiscordUserIds>
  <AllowedTorchCommands>
    <string>save</string>
    <string>restart</string>
    <string>stop</string>
    <string>start</string>
  </AllowedTorchCommands>

  <!-- Public links and server information -->
  <ConnectWebsiteUrl>https://therealmsofasgard.com</ConnectWebsiteUrl>
  <ConnectSupportUrl>https://tickets.therealmsofasgard.com</ConnectSupportUrl>
  <ConnectSupportEmail>help@therealmsofasgard.com</ConnectSupportEmail>
  <ServerPort>0</ServerPort>
  <EssentialsConfigPath></EssentialsConfigPath>
  <PlayerRulesMessage>Follow server rules, respect other players, and keep grids compliant before cleanup.</PlayerRulesMessage>
  <PlayerDiscordUrl></PlayerDiscordUrl>

  <!-- Voting and rewards: keep the API key private -->
  <SpaceEngineersVotePageUrl>https://space-engineers.com/server/244351/</SpaceEngineersVotePageUrl>
  <SpaceEngineersVoteApiKey>PASTE_SPACE_ENGINEERS_VOTE_API_KEY_HERE</SpaceEngineersVoteApiKey>
  <VoteRewardTorchCommand></VoteRewardTorchCommand>

  <!-- Player links are maintained automatically by !link -->
  <PlayerDiscordSteamMappings />

  <!-- Optional local server path used by the read-only backup commands -->
  <BackupDirectory></BackupDirectory>
</BridgeConfig>
