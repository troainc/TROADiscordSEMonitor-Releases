<?xml version="1.0" encoding="utf-8"?>
<!-- Monitor+ configuration. Only the settings owners actually tune are listed here;
     everything else uses sensible built-in defaults. Never publish a live config -
     it contains your bot token and vote API key. -->
<BridgeConfig>

  <!-- ============ Core connection ============ -->
  <Enabled>true</Enabled>
  <BotToken>PASTE_A_NEW_DISCORD_BOT_TOKEN_HERE</BotToken>
  <ServerName>TROA NX Asgard PvEPvP</ServerName>
  <ServerPort>0</ServerPort>
  <ServerToDiscord>true</ServerToDiscord>
  <BotToGame>false</BotToGame>
  <CommandPrefix>!</CommandPrefix>
  <TorchCommandPrefix>!</TorchCommandPrefix>
  <!-- Chat bridge lane control. RelayOnlyPlayerChat=true bridges ONLY real player chat to Discord;
       plugin/system chat (Cleaner+, TROA Profiler+, server broadcasts - no Steam identity) is skipped.
       Set false to relay everything. ChatBridgeIgnoredSenders is an extra name blocklist. -->
  <RelayOnlyPlayerChat>true</RelayOnlyPlayerChat>
  <ChatBridgeIgnoredSenders>
    <string>Cleaner+</string>
    <string>TROA Profiler+</string>
    <string>Monitor+</string>
    <string>Server</string>
  </ChatBridgeIgnoredSenders>

  <!-- ============ Channels (Discord channel IDs) ============ -->
  <ChatChannelId>PASTE_DISCORD_CHANNEL_ID_HERE</ChatChannelId>
  <CommandChannelId>PASTE_PRIVATE_ADMIN_CHANNEL_ID_HERE</CommandChannelId>
  <StatusChannelId></StatusChannelId>
  <PlayerStatusChannelId></PlayerStatusChannelId>
  <AdminLogChannelId></AdminLogChannelId>
  <StatusDashboardChannelId></StatusDashboardChannelId>
  <GridComplianceLogChannelId></GridComplianceLogChannelId>
  <AdvertisementChannelId></AdvertisementChannelId>
  <SaveNotificationChannelId></SaveNotificationChannelId>
  <StartupProgressChannelId></StartupProgressChannelId>
  <AdminCommandAuditChannelId></AdminCommandAuditChannelId>
  <!-- Optional single fallback webhook used when a channel post fails. -->
  <WebhookUrl></WebhookUrl>
  <GlobalColor>Green</GlobalColor>
  <!-- Colour of Discord chat shown in-game. DiscordGameTextColor is the message font -->
  <!-- (White, Green, Blue, Red, ...). DiscordGameHighlightColor is the sender-name colour -->
  <!-- and accepts a name, #RRGGBB, #RRGGBBAA, or R,G,B. Set these to stop the default brown name. -->
  <DiscordGameTextColor>White</DiscordGameTextColor>
  <DiscordGameHighlightColor>#00B7C3</DiscordGameHighlightColor>

  <!-- ============ Administrators and Torch access ============ -->
  <!-- Admin Steam IDs (64-bit). Add a <string> line per admin. -->
  <AdminSteamIds>
    <string>PASTE_ADMIN_1_STEAM_ID_64_HERE</string>
  </AdminSteamIds>
  <!-- DISCORD_USER_ID:STEAM_ID_64 per admin. -->
  <DiscordSteamMappings>
    <string>PASTE_ADMIN_1_DISCORD_USER_ID:PASTE_ADMIN_1_STEAM_ID_64_HERE</string>
  </DiscordSteamMappings>
  <AdminDiscordUserIds>
    <string>PASTE_ADMIN_1_DISCORD_USER_ID</string>
  </AdminDiscordUserIds>
  <AllowedTorchCommands>
    <string>save</string>
    <string>restart</string>
    <string>stop</string>
    <string>start</string>
  </AllowedTorchCommands>
  <!-- Security default: false = only AllowedTorchCommands can be forwarded from Discord.
       Set true only to intentionally allow any Torch/plugin command for trusted admins.
       Note: even when true, commands that are NOT in AllowedTorchCommands (typically other
       plugins' commands) are forwarded quietly and logged to the server log only - Monitor+
       does not post chatter for them or re-badge their output in Discord. -->
  <AllowAnyTorchCommand>false</AllowAnyTorchCommand>

  <!-- ============ Feature toggles ============ -->
  <UsePlayerStatus>true</UsePlayerStatus>
  <UseAdminPlayerLog>true</UseAdminPlayerLog>
  <UseStartupProgress>true</UseStartupProgress>
  <UseSaveNotifications>true</UseSaveNotifications>
  <EnableAutomaticSaveSchedule>true</EnableAutomaticSaveSchedule>
  <UseDiscordPresence>true</UseDiscordPresence>
  <DiscordPresenceShowPlayerNames>true</DiscordPresenceShowPlayerNames>
  <EnableStatusDashboard>false</EnableStatusDashboard>
  <StatusDashboardAcceptCommands>false</StatusDashboardAcceptCommands>
  <UseAdminCommandAudit>true</UseAdminCommandAudit>
  <StatusTimeZoneId>Eastern Standard Time</StatusTimeZoneId>

  <!-- ============ Advertisements ============ -->
  <EnableAdvertisements>true</EnableAdvertisements>
  <AdvertisementAuthor>Monitor+</AdvertisementAuthor>
  <AdvertisementColor>Green</AdvertisementColor>
  <DiscordAdvertisements>
    <string>Welcome to the server.</string>
    <string>Join our community Discord for server news and support.</string>
  </DiscordAdvertisements>
  <GameAdvertisements>
    <string>Welcome to the server.</string>
    <string>Join our community Discord for server news and support.</string>
  </GameAdvertisements>

  <!-- ============ World Protection and Privacy (grid compliance) ============ -->
  <!-- false turns off ALL new-grid monitoring, warnings, reminders, and audits.
       Takes effect on !reload; the !gridcheck player command is unaffected. -->
  <EnableGridComplianceWarnings>true</EnableGridComplianceWarnings>
  <GridComplianceMinimumBlocks>25</GridComplianceMinimumBlocks>

  <!-- ============ Player commands ============ -->
  <PlayerRulesMessage>Follow server rules, respect other players, and keep grids compliant before cleanup.</PlayerRulesMessage>
  <PlayerDiscordUrl></PlayerDiscordUrl>
  <EnablePlayerSelfLinking>true</EnablePlayerSelfLinking>
  <PlayerDiscordSteamMappings />

  <!-- ============ Backups ============ -->
  <!-- Blank BackupDirectory auto-detects the Backups folder beside the world's Saves. -->
  <BackupDirectory></BackupDirectory>
  <BackupListCount>10</BackupListCount>

  <!-- ============ Voting ============ -->
  <EnableVoting>true</EnableVoting>
  <EnableVoteLeaderboard>true</EnableVoteLeaderboard>
  <VoteLeaderboardCount>10</VoteLeaderboardCount>
  <SpaceEngineersVotePageUrl>https://space-engineers.com/server/244351/</SpaceEngineersVotePageUrl>
  <SpaceEngineersVoteApiKey></SpaceEngineersVoteApiKey>
  <VoteRewardTorchCommand></VoteRewardTorchCommand>

  <!-- ============ Economy connector (optional) ============ -->
  <!-- true lets players check their credit balance via /monitorplus balance (Discord)
       and !balance (in-game). Reads the server's built-in Space Engineers economy through
       reflection, so it stays off by default and fails gracefully if no economy is active. -->
  <EnableEconomyConnector>false</EnableEconomyConnector>

  <!-- ============ Support / links ============ -->
  <ConnectWebsiteUrl>https://therealmsofasgard.com</ConnectWebsiteUrl>
  <ConnectSupportUrl>https://tickets.therealmsofasgard.com</ConnectSupportUrl>
  <ConnectSupportEmail>help@therealmsofasgard.com</ConnectSupportEmail>

</BridgeConfig>
